[
  {"id":"tab-agri","type":"tab","label":"Agri-Logistix Monitor","disabled":false,"info":"Reads newline-delimited JSON from Arduino Uno at 9600 baud. Set the serial device below to the correct COM/tty port."},
  {"id":"serial-port-uno","type":"serial-port","serialport":"COM3","serialbaud":"9600","databits":"8","parity":"none","stopbits":"1","waitfor":"\\n","dtr":"none","rts":"none","cts":"none","dsr":"none","newline":"\\n","bin":"false","out":"char","addchar":"","responsetimeout":"10000"},
  {"id":"serial-in-uno","type":"serial in","z":"tab-agri","name":"Arduino Uno JSON (change COM3)","serial":"serial-port-uno","x":160,"y":120,"wires":[["json-parse"]]},
  {"id":"json-parse","type":"json","z":"tab-agri","name":"Parse sensor JSON","property":"payload","action":"obj","pretty":false,"x":370,"y":120,"wires":[["normalise-alert"]]},
  {"id":"normalise-alert","type":"function","z":"tab-agri","name":"Validate readings + alert rules","func":"const d = msg.payload || {};\nconst t = Number(d.temp);\nconst h = Number(d.humidity);\nconst sensorOk = d.sensor_ok !== false && d.temp !== null && Number.isFinite(t) && d.humidity !== null && Number.isFinite(h);\nconst door = String(d.door || 'UNKNOWN').toUpperCase();\nconst reasons = [];\nif (!sensorOk) reasons.push('Sensor read error');\nif (sensorOk && (t > 12 || t < 5)) reasons.push('Temperature outside 5–12 °C');\nif (door === 'OPEN') reasons.push('Door is OPEN');\nconst active = reasons.length > 0;\nconst tempMsg = {payload: sensorOk ? t : 0};\nconst humidityMsg = {payload: sensorOk ? h.toFixed(1) + ' %' : 'Sensor error'};\nconst doorMsg = {payload: door};\nconst alertMsg = {payload: {active, message: active ? 'ALERT: ' + reasons.join(' | ') : 'NORMAL - conditions within limits'}};\nreturn [tempMsg, humidityMsg, doorMsg, alertMsg];","outputs":4,"noerr":0,"initialize":"","finalize":"","libs":[],"x":630,"y":120,"wires":[["temp-gauge"],["humidity-text"],["door-text"],["alert-template"]]},
  {"id":"ui-tab-agri","type":"ui_tab","name":"Agri-Logistix","icon":"dashboard","disabled":false,"hidden":false},
  {"id":"ui-group-status","type":"ui_group","name":"Live Cargo Status","tab":"ui-tab-agri","order":1,"disp":true,"width":"12","collapse":false,"className":""},
  {"id":"temp-gauge","type":"ui_gauge","z":"tab-agri","name":"Cargo temperature","group":"ui-group-status","order":1,"width":6,"height":4,"gtype":"gage","title":"Temperature","label":"°C","format":"{{value}}","min":0,"max":"40","colors":["#00b500","#e6e600","#ca3838"],"seg1":"5","seg2":"12","x":900,"y":80,"wires":[]},
  {"id":"humidity-text","type":"ui_text","z":"tab-agri","group":"ui-group-status","order":2,"width":6,"height":1,"name":"Humidity","label":"Humidity","format":"{{msg.payload}}","layout":"row-spread","x":900,"y":140,"wires":[]},
  {"id":"door-text","type":"ui_text","z":"tab-agri","group":"ui-group-status","order":3,"width":6,"height":1,"name":"Door state","label":"Door","format":"{{msg.payload}}","layout":"row-spread","x":900,"y":200,"wires":[]},
  {"id":"alert-template","type":"ui_template","z":"tab-agri","group":"ui-group-status","name":"Alert indicator","order":4,"width":12,"height":2,"format":"<div style=\"padding:14px;text-align:center;font-weight:bold;color:#fff;border-radius:6px;background:{{msg.payload.active ? '#c62828' : '#2e7d32'}}\">{{msg.payload.message}}</div>","storeOutMessages":true,"fwdInMessages":true,"resendOnRefresh":true,"templateScope":"local","x":900,"y":260,"wires":[[]]},
  {"id":"demo-inject","type":"inject","z":"tab-agri","name":"Manual demo sample (not live sensor data)","props":[{"p":"payload"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"{\"temp\":13.4,\"humidity\":72.0,\"door\":\"CLOSED\",\"sensor_ok\":true}","payloadType":"json","x":210,"y":260,"wires":[["normalise-alert"]]}
]
