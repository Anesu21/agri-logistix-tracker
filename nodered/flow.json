  {
    "id": "agri_sensor_router",
    "type": "function",
    "z": "e881198af53dfdc6",
    "name": "Route Sensor Readings",
    "func": "const d = msg.payload;\n\nif (!d || typeof d !== \"object\") {\n    node.warn(\"Invalid Arduino JSON payload\");\n    return null;\n}\n\nfunction numericMessage(value, topic) {\n    const n = Number(value);\n    if (value === null || value === undefined ||\n        value === \"\" || !Number.isFinite(n)) {\n        return null;\n    }\n    return { payload: n, topic: topic };\n}\n\nreturn [\n    numericMessage((d.temperature ?? d.temp), \"Temperature\"),\n    numericMessage(d.humidity, \"Humidity\"),\n    d.door !== undefined\n        ? { payload: String(d.door), topic: \"Door\" }\n        : null,\n    numericMessage(d.battery, \"Battery\"),\n    { payload: \"ONLINE\", topic: \"Connection\" }\n];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 960,
    "y": 260,
    "wires": [
